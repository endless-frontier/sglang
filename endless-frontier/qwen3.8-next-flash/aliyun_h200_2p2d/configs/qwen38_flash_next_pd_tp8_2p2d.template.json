{
  "schema_version": "qwen38-flash-next-h200-deployment-v1",
  "name": "qwen38-flash-next-pd-tp8-2p2d",
  "mode": "pd",
  "aliyun": {
    "region": "cn-shanghai",
    "endpoint": "pai-dlc.cn-shanghai.aliyuncs.com",
    "workspace_id": "REPLACE_WITH_H200_WORKSPACE_ID",
    "resource_id": "REPLACE_WITH_H200_DLC_QUOTA_OR_RESOURCE_ID",
    "priority": 5,
    "nodes": 4,
    "gpus_per_node": 8,
    "worker_cpu": 160,
    "worker_memory": "1500Gi",
    "worker_shared_memory": "256Gi",
    "worker_image": "REPLACE_WITH_CUDA13_QWEN38_SGLANG_IMAGE_URI",
    "image_verified_for_qwen38_bf16": false,
    "image_source_note": "需要提供含 CUDA 13.0 toolkit/nvcc、PyTorch cu130、sglang-kernel 0.4.7 的可拉取镜像",
    "enable_rdma": true,
    "job_max_running_time_minutes": 0,
    "data_sources": [
      {
        "data_source_id": "REPLACE_WITH_CPFS_DATASOURCE_ID",
        "mount_path": "/mnt/data",
        "options": "{}"
      }
    ],
    "user_vpc": {
      "vpc_id": "REPLACE_WITH_H200_VPC_ID",
      "switch_id": "REPLACE_WITH_H200_VSWITCH_ID",
      "security_group_id": "REPLACE_WITH_H200_SECURITY_GROUP_ID",
      "extended_cidrs": []
    }
  },
  "topology": {
    "prefill_nodes": 2,
    "decode_nodes": 2,
    "tensor_parallel_size": 8,
    "pipeline_parallel_size": 1
  },
  "runtime": {
    "project_root": "/mnt/data/xinyu",
    "worker_ip_cidr": "",
    "model_path": "/mnt/data/public_models/Qwen3.8-Flash-Next",
    "sglang_source": "/mnt/data/xinyu/sglang-qwen38-upstream-1789383617",
    "cuda_home": "/usr/local/cuda",
    "served_model_name": "Qwen3.8-Flash-Next",
    "python_executable": "python3",
    "sglang_module": "sglang.launch_server",
    "service_port": 8000,
    "router_port": 8001,
    "bootstrap_port": 8998,
    "dist_port": 29500,
    "dtype": "bfloat16",
    "context_length": 1048576,
    "max_total_tokens": 6000000,
    "mem_fraction_static": 0.85,
    "schedule_conservativeness": 1.0,
    "page_size": 64,
    "max_running_requests": 8,
    "max_queued_requests": null,
    "chunked_prefill_size": 8192,
    "cuda_graph_max_bs": null,
    "reasoning_parser": "qwen3",
    "tool_call_parser": "qwen3_coder",
    "mamba_scheduler_strategy": "extra_buffer",
    "mamba_ssm_dtype": "bfloat16",
    "mamba_full_memory_ratio": null,
    "max_mamba_cache_size": null,
    "disaggregation_transfer_backend": "mooncake",
    "watchdog_timeout_seconds": 1800,
    "node_discovery_timeout_seconds": 1800,
    "startup_timeout_seconds": 7200,
    "gpu_usage_probe_timeout_seconds": 300,
    "enable_metrics": true,
    "enable_metrics_for_all_schedulers": false,
    "enable_mfu_metrics": false,
    "enable_request_time_stats_logging": true,
    "router_prometheus_port": 29000,
    "sglang_env": {
      "SGLANG_ALLOW_OVERWRITE_LONGER_CONTEXT_LEN": "1",
      "SGLANG_MOE_CONFIG_DIR": "/mnt/data/xinyu/moe_configs",
      "SGLANG_OPT_FUSE_SWIGLU_INTERLEAVED": "1"
    },
    "role_overrides": {
      "prefill": {
        "max_running_requests": 8,
        "load_balance_method": "follow_bootstrap_room",
        "disable_prefill_cuda_graph": true
      },
      "decode": {
        "max_running_requests": 96,
        "load_balance_method": "total_requests"
      }
    },
    "extra_sglang_args": [
      "--attention-backend",
      "fa3",
      "--kv-cache-dtype",
      "bfloat16",
      "--num-continuous-decode-steps",
      "1",
      "--scheduler-recv-interval",
      "1",
      "--enable-fused-moe-sum-all-reduce",
      "--moe-runner-backend",
      "auto",
      "--speculative-moe-runner-backend",
      "auto",
      "--mamba-backend",
      "triton",
      "--mamba-radix-cache-strategy",
      "extra_buffer",
      "--linear-attn-prefill-backend",
      "flashinfer",
      "--linear-attn-decode-backend",
      "flashinfer",
      "--linear-attn-verify-backend",
      "triton",
      "--cuda-graph-max-bs-decode",
      "32",
      "--flashinfer-allreduce-fusion-backend",
      "auto",
      "--speculative-algorithm",
      "NEXTN",
      "--speculative-num-steps",
      "3",
      "--speculative-eagle-topk",
      "1",
      "--speculative-num-draft-tokens",
      "4",
      "--tokenizer-worker-num",
      "6"
    ]
  },
  "router": {
    "prefill_policy": "round_robin",
    "decode_policy": "round_robin",
    "max_concurrent_requests": 4,
    "queue_size": 0,
    "queue_timeout_secs": 60,
    "request_timeout_secs": 7200,
    "worker_startup_timeout_secs": 1800,
    "disable_retries": false,
    "cb_failure_threshold": 10,
    "cb_success_threshold": 3,
    "cb_timeout_duration_secs": 60,
    "cb_window_duration_secs": 120,
    "health_failure_threshold": 3,
    "health_success_threshold": 2,
    "health_check_timeout_secs": 5,
    "health_check_interval_secs": 10
  }
}
