-        available = min(chunk_limit, int(self.remaining_total))
-        # Single-pool continuation must make progress to release its KV.
-        return available if available > 0 else chunk_limit
-
-    def fit_chunk(
-        self,
-        *,
-        extend_input_len: int,
-        max_new_tokens: int,
-        chunk_limit: int,
-    ) -> int | None:
-        return chunk_limit
+        available = min(chunk_limit, int(self.remaining_total), int(self.remaining_current))
+        return available if available > 0 else None
+
+    def fit_chunk(self, *, extend_input_len: int, max_new_tokens: int,
+                  chunk_limit: int) -> int | None:
+        candidate = min(extend_input_len, chunk_limit)
+        headroom = max_new_tokens if candidate >= extend_input_len else 0
+        available = int(min(self.remaining_current, self.remaining_total)) - self.page_size - headroom
+        cap = max(0, available // self.page_size * self.page_size)
+        return min(candidate, cap) if cap > 0 else None
