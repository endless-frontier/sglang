+"""Metadata-only scheduler stage journal. Called by the deployment recipe."""
+import functools
+from collections import deque
+import json
+import logging
+from logging.handlers import RotatingFileHandler
+import os
+import time
+from pathlib import Path
+
+_installed = False
+# Bounded telemetry ring, never a request/queue limit. Missing old IDs keep credit.
+_admission_ring = deque(maxlen=256)
+
+def admission_snapshot():
+    return {'protocol': 'same-worker-admission-v1', 'rank': int(os.environ['QWEN38_NODE_RANK']), 'recent': list(_admission_ring), 'fair_prefill': dict(_fair_status)}
+_logger = None
+PHASES = {
+    'set_prefill_bootstrap_queue_entry_time': 'p_bootstrap',
+    'set_decode_prealloc_queue_entry_time': 'd_prealloc',
+    'set_decode_transfer_queue_entry_time': 'd_allocated',
+    'set_wait_queue_entry_time': 'compute_wait',
+    'set_forward_entry_time': 'forward_start',
+    'set_prefill_finished_time': 'prefill_finished',
+    'set_prefill_transfer_queue_entry_time': 'p_transfer',
+    'set_prefill_kv_transfer_finish_time': 'p_kv_finished',
+    'set_completion_time': 'completed',
+}
+
+def emit(stats, phase):
+    global _logger
+    try:
+        meta = getattr(stats, '_pd_meta', None)
+        if not meta or phase in stats._pd_seen:
+            return
+        stats._pd_seen.add(phase)
