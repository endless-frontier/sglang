+"""Reserve unfinished P owners before admitting a new context; no policy changes."""
+def aligned(n,page):
+    return ((max(0,int(n))+page-1)//page)*page
+
+def paused_completion_debt(requests,selected,page):
+    chosen={r.rid for r in selected}
+    unique={r.rid:r for r in requests if not r.finished() and not r.is_retracted}
+    debt=0
+    for r in unique.values():
+        end=r.extend_range.end if r.rid in chosen else r.kv.kv_allocated_len
+        remaining=max(0,aligned(len(r.origin_input_ids),page)-aligned(end,page))
+        if remaining:
+            debt+=remaining+page+max(0,r.sampling_params.max_new_tokens-len(r.output_ids))
+    return debt
